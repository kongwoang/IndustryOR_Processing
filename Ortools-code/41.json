{
  "input_format": {
    "initial_capital": "number",
    "horizon_years": "integer",
    "products": [
      {
        "id": "string",
        "available_at_start_of_years": ["integer"],
        "maturity_end_of_year": "integer",
        "payoff_multiplier": "number",
        "capacity": "number|null"
      }
    ]
  },
  "output_format": {
    "investments": [
      {
        "product_id": "string",
        "start_year": "integer",
        "amount": "number"
      }
    ],
    "cash_carryover": [
      {
        "from_year_end": "integer",
        "amount": "number"
      }
    ],
    "ending_wealth": "number"
  },
