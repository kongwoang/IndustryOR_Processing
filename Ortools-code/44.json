{
  "input_format": {
    "production_points": [
      {
        "id": "int",
        "supply": "number"
      }
    ],
    "demand_points": [
      {
        "id": "int",
        "demand": "number"
      }
    ],
    "stations": [
      {
        "id": "int",
        "fixed_cost": "number",
        "capacity": "number"
      }
    ],
    "cost_source_to_station": "number matrix of shape m x p",
    "cost_station_to_demand": "number matrix of shape p x n"
  },
  "output_format": {
    "open_stations": [
      {
        "station_id": "int",
        "used": "0_or_1",
        "throughput": "number"
      }
    ],
    "shipments": [
      {
        "from_production": "int",
        "via_station": "int",
        "to_demand": "int",
        "quantity": "number"
      }
    ]
  },
  "example_input": {
    "production_points": [
      {
        "id": 1,
        "supply": 100
      },
      {
        "id": 2,
        "supply": 150
      }
    ],
    "demand_points": [
      {
        "id": 1,
        "demand": 80
      },
      {
        "id": 2,
        "demand": 120
      }
    ],
    "stations": [
