{
  "input_format": {
    "months": ["integer"],
    "required_area_sqm": {
      "1": "integer",
      "2": "integer",
      "3": "integer",
      "4": "integer"
    },
    "contract_options": [
      {
        "length_months": "integer",
        "rental_fee_per_100sqm_yuan": "integer"
      }
    ],
    "area_unit_sqm": "integer",
    "rules": {
      "allow_parallel_contracts": "boolean",
      "min_distinct_contract_lengths": "integer",
      "max_distinct_contract_lengths": "integer",
      "mutual_exclusion_lengths": ["integer", "integer"],
      "exact_monthly_satisfaction": "boolean"
    }
  },
  "output_format": {
    "minimum_total_rental_cost_yuan": "number",
    "used_contract_lengths_months": ["integer"],
    "contracts": [
      {
        "start_month": "integer",
        "length_months": "integer",
        "units_of_100sqm": "integer",
        "area_sqm": "integer",
        "cost_yuan": "integer"
      }
    ],
    "monthly_covered_area_sqm": {
      "1": "integer",
      "2": "integer",
      "3": "integer",
      "4": "integer"
    }
  },
  "example_input": {
    "months": [1, 2, 3, 4],
    "required_area_sqm": {
      "1": 1500,
      "2": 1000,
      "3": 2000,
      "4": 1200
    },
    "contract_options": [
      {
        "length_months": 1,
        "rental_fee_per_100sqm_yuan": 4000
      },
      {
        "length_months": 2,
        "rental_fee_per_100sqm_yuan": 7500
      },
      {
        "length_months": 3,
        "rental_fee_per_100sqm_yuan": 10500
      },
      {
        "length_months": 4,
        "rental_fee_per_100sqm_yuan": 13000
      }
    ],
    "area_unit_sqm": 100,
    "rules": {
      "allow_parallel_contracts": true,
      "min_distinct_contract_lengths": 2,
      "max_distinct_contract_lengths": 3,
      "mutual_exclusion_lengths": [1, 4],
      "exact_monthly_satisfaction": true
    }
  }
}