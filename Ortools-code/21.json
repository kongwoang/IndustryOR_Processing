{
  "input_format": {
    "suppliers": {
      "A": {
        "cost_per_table": "number",
        "tables_per_order": "integer"
      },
      "B": {
        "cost_per_table": "number",
        "tables_per_order": "integer"
      },
      "C": {
        "cost_per_table": "number",
        "tables_per_order": "integer"
      }
    },
    "requirements": {
      "min_total_tables": "integer",
      "max_total_tables": "integer"
    },
    "logic_constraints": {
      "if_order_A_then_min_tables_from_B": "integer",
      "if_order_B_then_order_C": "boolean"
    }
  },
  "output_format": {
    "orders": {
      "A": "integer",
      "B": "integer",
      "C": "integer"
    },
    "tables": {
      "A": "integer",
      "B": "integer",
      "C": "integer",
      "total": "integer"
    },
    "total_cost": "number"
  },
  "example_input": {
    "suppliers": {
      "A": {
        "cost_per_table": 120,
        "tables_per_order": 20
      },
      "B": {
        "cost_per_table": 110,
        "tables_per_order": 15
      },
      "C": {
        "cost_per_table": 100,
        "tables_per_order": 15
      }
    },
    "requirements": {
      "min_total_tables": 150,
      "max_total_tables": 600
    },
    "logic_constraints": {
      "if_order_A_then_min_tables_from_B": 30,
      "if_order_B_then_order_C": true
    }
  }
}