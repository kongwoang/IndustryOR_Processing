{
  "input_format": {
    "products": ["string"],
    "machines": ["string"],
    "processing_time_minutes_per_lot": {
      "product_name": {
        "machine_name": "number"
      }
    },
    "beginning_inventory_lots": {
      "product_name": "number"
    },
    "available_hours": {
      "machine_name": "number"
    },
    "forecast_demand_lots": {
      "product_name": "number"
    },
    "fractional_lots_allowed": "boolean"
  },
  "output_format": {
